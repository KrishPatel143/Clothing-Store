# Copy to VM: /etc/nginx/sites-available/http-only (or similar)
# Cert paths are set by certbot for:
#   linencutandmore.aviusolutions.com
#   linencutandmoreapi.aviusolutions.com
#
# After editing:
#   sudo nginx -t && sudo systemctl reload nginx

# Frontend — Vite dev on 5173 (include WebSocket headers for HMR)
server {
    listen 443 ssl http2;
    server_name linencutandmore.aviusolutions.com;

    # certbot-managed paths (adjust if your live path differs)
    ssl_certificate     /etc/letsencrypt/live/linencutandmore.aviusolutions.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linencutandmore.aviusolutions.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}

# API — Node on 5000
server {
    listen 443 ssl http2;
    server_name linencutandmoreapi.aviusolutions.com;

    ssl_certificate     /etc/letsencrypt/live/linencutandmore.aviusolutions.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linencutandmore.aviusolutions.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        client_max_body_size 12m;
    }
}
